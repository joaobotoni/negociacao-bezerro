<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cartao_item_cidade"
    style="?attr/materialCardViewFilledStyle"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="@dimen/spacing_xs"
    android:clickable="true"
    android:focusable="true"
    app:cardBackgroundColor="?attr/colorSurfaceContainerLow"
    app:shapeAppearance="?attr/shapeAppearanceCornerLarge">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="@dimen/spacing_md">

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/container_icone"
            style="?attr/materialCardViewFilledStyle"
            android:layout_width="@dimen/touch_icon_container"
            android:layout_height="@dimen/touch_icon_container"
            app:cardBackgroundColor="?attr/colorPrimaryContainer"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:shapeAppearance="?attr/shapeAppearanceCornerExtraExtraLarge">

            <ImageView
                android:id="@+id/imagem_icone_localizacao"
                android:layout_width="@dimen/icon_md"
                android:layout_height="@dimen/icon_md"
                android:layout_gravity="center"
                android:contentDescription="@null"
                app:srcCompat="@drawable/location_on_24px"
                app:tint="?attr/colorPrimary" />

        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:id="@+id/texto_nome_cidade"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_lg"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="?attr/colorOnSurface"
            android:textStyle="bold"
            app:layout_constraintBottom_toTopOf="@+id/texto_nome_estado"
            app:layout_constraintStart_toEndOf="@+id/container_icone"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_chainStyle="packed"
            tools:text="@string/tools_nome_cidade_placeholder" />

        <TextView
            android:id="@+id/texto_nome_estado"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_lg"
            android:layout_marginTop="@dimen/spacing_xxs"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="?attr/colorOnSurfaceVariant"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@+id/container_icone"
            app:layout_constraintTop_toBottomOf="@+id/texto_nome_cidade"
            tools:text="@string/tools_nome_estado_placeholder" />

        <ImageView
            android:id="@+id/icone_seta"
            android:layout_width="@dimen/spacing_lg"
            android:layout_height="@dimen/spacing_lg"
            android:contentDescription="@null"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/arrow_forward_ios_24px"
            app:tint="?attr/colorOutlineVariant" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>