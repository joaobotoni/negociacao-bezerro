<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="?attr/materialCardViewFilledStyle"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/size_small"
    android:clickable="true"
    android:contentDescription="@null"
    android:focusable="true"
    app:cardBackgroundColor="?attr/colorSurfaceContainerLow"
    app:shapeAppearance="?attr/shapeAppearanceCornerExtraExtraLarge">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="@dimen/size_medium">

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_view_item_negociacao_icone"
            style="?attr/materialCardViewFilledStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="?attr/colorSurfaceContainer"
            app:contentPadding="@dimen/size_extra_small"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:shapeAppearance="?attr/shapeAppearanceCornerExtraExtraLarge">

            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:importantForAccessibility="no"
                android:src="@drawable/sell_24px"
                app:tint="?attr/colorOnSecondaryContainer" />
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:id="@+id/text_view_item_negociacao_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/size_small"
            android:textAppearance="?attr/textAppearanceBodyLarge"
            android:textColor="?attr/colorOnSurface"
            app:layout_constraintBottom_toTopOf="@id/text_view_item_negociacao_descricao"
            app:layout_constraintStart_toEndOf="@id/card_view_item_negociacao_icone"
            app:layout_constraintTop_toTopOf="@id/card_view_item_negociacao_icone"
            app:layout_constraintVertical_chainStyle="packed"
            tools:text="@string/sincronizacao_item_title" />

        <TextView
            android:id="@+id/text_view_item_negociacao_descricao"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/size_small"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="?attr/colorOnSurfaceVariant"
            app:layout_constraintBottom_toBottomOf="@id/card_view_item_negociacao_icone"
            app:layout_constraintStart_toEndOf="@id/card_view_item_negociacao_icone"
            app:layout_constraintTop_toBottomOf="@id/text_view_item_negociacao_title"
            tools:text="@string/sincronizacao_item_example_desc" />

        <ImageView
            android:id="@+id/image_view_item_negociacao"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:importantForAccessibility="no"
            android:src="@drawable/schedule_24px"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="?attr/colorOnSurfaceVariant" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>